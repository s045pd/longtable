{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longtable",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARDS", "class_name": "BoardRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  // Workers AI turns a pasted chat into notes (free plan: 10,000 neurons a day).
  "ai": { "binding": "AI" },
  // Browser Rendering draws the week as a picture for AI assistants over MCP (free plan: 10 minutes a day).
  "browser": { "binding": "BROWSER" },
  "observability": { "enabled": true }
}
