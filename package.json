{
  "name": "longtable",
  "version": "0.1.0",
  "private": true,
  "description": "Longtable: a live, shared planning board that tidies into a week.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s045pd/longtable.git"
  },
  "type": "module",
  "scripts": {
    "setup": "node scripts/deploy-cloudflare.mjs",
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev --local",
    "dev:worker:ai": "npm run build && wrangler dev",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.1.7",
    "vitest": "5.0.5",
    "wrangler": "4.160.0"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "2.0.0",
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource-variable/caveat": "5.2.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8"
  },
  "engines": {
    "node": ">=20"
  },
  "cloudflare": {
    "bindings": {
      "BOARDS": {
        "description": "Each board is one Durable Object with its own SQLite storage (free plan)."
      },
      "CREATE_PASSWORD": {
        "description": "Optional secret. Set it (Settings → Variables and Secrets) and only people who know it can start new boards; people you send a board link to never need it."
      }
    }
  }
}
