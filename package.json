{
  "name": "longtable",
  "version": "0.1.0",
  "private": true,
  "description": "Longtable: a live, shared planning board that tidies into a week.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.1.7",
    "vitest": "5.0.5",
    "wrangler": "4.160.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.2.10",
    "@fontsource-variable/caveat": "5.2.8",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8"
  },
  "engines": {
    "node": ">=20"
  }
}
